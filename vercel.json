{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/au",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/pricing/:path*",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/pricing.html",
      "destination": "/contact",
      "permanent": false
    }
  ]
}
